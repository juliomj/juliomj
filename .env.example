APP_NAME=pokemon-price-compare
ENV=dev
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=12
RETRY_ATTEMPTS=3
CACHE_TTL_SECONDS=300
MATCH_MIN_SCORE=75
RATE_LIMIT_PER_MINUTE=120
MYP_SEARCH_URL=https://www.mypcards.com.br/busca
LIGA_SEARCH_URL=https://www.ligapokemon.com.br/?view=cards/search
ENABLE_PLAYWRIGHT_FALLBACK=false
MYP_HEADERS_USER_AGENT=Mozilla/5.0 (compatible; PokemonPriceBot/1.0)
LIGA_HEADERS_USER_AGENT=Mozilla/5.0 (compatible; PokemonPriceBot/1.0)
DECISION_MIN_SAVINGS_PERCENT=0
